# Copy to .env for local overrides. The defaults below already match the
# docker-compose Redis, so you don't need a .env file to run locally.
TQ_REDIS_HOST=localhost
TQ_REDIS_PORT=6379
TQ_REDIS_DB=0
TQ_NAMESPACE=taskq

# --- reliability (Stage 2) ---
# Lease: how long a claimed job may run before it is presumed crashed and
# requeued by the reaper. MUST exceed your slowest job's runtime.
TQ_LEASE_SECONDS=30
# How often each worker sweeps for expired leases and due retries.
TQ_REAPER_INTERVAL=5
# Worker sleep between claim attempts when the queue is empty.
TQ_POLL_INTERVAL=0.5
# Retry backoff: delay = min(cap, base * 2^(failures-1)), randomized +/-jitter.
TQ_RETRY_BASE=2
TQ_RETRY_CAP=120
TQ_RETRY_JITTER=0.25
